<?xml version="1.0" encoding="utf-8"?>
<!--
  Modern Auto Backup / device-transfer rules (API 31+ via
  android:dataExtractionRules). Mirrors backup_rules.xml: keeps the
  WiFi/Bluetooth tethering auth tokens (etphonehome_tokens.xml, written by
  TokenManager) out of both cloud backup and the Android 12+ "copy my data"
  device-to-device transfer flow, for the same reason: those tokens are
  the sole auth gate on this app's tethering handshake.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="etphonehome_tokens.xml" />
        <exclude domain="sharedpref" path="etph_pro.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="etphonehome_tokens.xml" />
        <exclude domain="sharedpref" path="etph_pro.xml" />
    </device-transfer>
</data-extraction-rules>
