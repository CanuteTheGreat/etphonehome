<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Access network state -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- WiFi permissions -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- No location / NEARBY_WIFI_DEVICES: nothing uses them (the WiFi address comes from
         NetworkInterface, mDNS needs neither), and Play asks every app that declares
         location to justify it. -->

    <!-- Bluetooth permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Wake lock to keep connection alive -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- For Android 12+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- USB accessory link (Android Open Accessory): computers and routers with ETPH reach the
         app over the cable without Developer options / USB debugging. Optional hardware. -->
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />

    <!-- Package visibility (Android 11+) for exactly one app: the old ET Phone Home
         build (com.etphonehome), so MainActivity can tell the user it is still installed. -->
    <queries>
        <package android:name="com.etphonehome" />
        <!-- Google Play Store: the Pro screen says "billing isn't available" when its billing service is missing -->
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".EtphApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ETPhoneHome"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:theme="@style/Theme.ETPhoneHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ETPH Pro screen (Upgrade to Pro). -->
        <activity
            android:name=".UpgradeActivity"
            android:exported="false"
            android:label="@string/pro_title"
            android:theme="@style/Theme.ETPhoneHome" />

        <!-- Auto-start on plug-in (Pro): the computer runs `adb shell am start -n
             solutions.errant.etph/com.etphonehome.AutoStartActivity` over USB debugging. Exported
             so the shell can start it; it only ever starts USB sharing (loopback, behind adb
             forward), checks who started it on Android 14+, and the phone's Free/Pro gate decides. -->
        <activity
            android:name=".AutoStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- "Open ETPH ...?" when a computer/router with ETPH switches the phone into USB
             accessory mode (strings in res/xml/accessory_filter.xml). Exported because the system
             starts it; it only hands the accessory to TetherService (see AccessoryActivity). -->
        <activity
            android:name=".AccessoryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!-- Emulator e2e builds only (-PbillingTestHooks=true): force Free/Pro. Disabled in every
             other build (and TestHookReceiver checks BuildConfig.BILLING_TEST_HOOKS too). -->
        <receiver
            android:name=".billing.TestHookReceiver"
            android:enabled="${billingTestHooks}"
            android:exported="true"
            tools:ignore="ExportedReceiver" />

        <!-- Tethering service: listens for the desktop and relays its
             traffic through ordinary phone sockets (no VPN, no root). -->
        <service
            android:name=".service.TetherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shares the phone's internet connection with a computer (tethering) over USB, WiFi or Bluetooth" />
        </service>

    </application>

</manifest>
