<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight: the DEVICE's light/dark setting picks values/ or values-night/ (live; Android
         recreates the activity on a change). Never force a mode in code (CI check
         CI check-no-forced-theme.py). Brand colors come from colors.xml, which has
         a values-night override, so they stay legible in both modes. -->
    <style name="Theme.ETPhoneHome" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/etph_primary</item>
        <item name="colorOnPrimary">@color/etph_on_primary</item>
        <item name="colorSecondary">@color/etph_secondary</item>
        <item name="colorOnSecondary">@color/etph_on_secondary</item>
    </style>
</resources>
