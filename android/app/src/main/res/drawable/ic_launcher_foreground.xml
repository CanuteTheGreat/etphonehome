<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground (108dp canvas, launchers show the middle 72dp, masks keep a 66dp
     circle): a phone with an arrow on its screen, centred. The 24-unit Material glyphs are scaled
     2.25x around the canvas centre (54,54), so the phone is 49.5dp tall and every corner stays
     inside the 66dp safe circle. store/graphics/make-graphics.py renders the Play icon from this. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.25"
        android:scaleY="2.25"
        android:translateX="27"
        android:translateY="27">
        <!-- Phone -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17,1.01L7,1C5.9,1,5,1.9,5,3v18c0,1.1,0.9,2,2,2h10c1.1,0,2-0.9,2-2V3C19,1.9,18.1,1.01,17,1.01zM17,19H7V5h10V19z"/>
        <!-- Arrow on the screen, pointing out of the phone -->
        <path
            android:fillColor="#4CAF50"
            android:pathData="M8.59,16.59L13.17,12L8.59,7.41L10,6l6,6l-6,6L8.59,16.59z"
            android:translateX="-0.3"/>
    </group>
</vector>
