#!/bin/sh /etc/rc.common
# Errant Solutions ETPH: makes sure the router has its adb key before a
# phone is plugged in (RSA key generation takes a while on router CPUs).
# USB phones are reached by the client's built-in ADB host; no adb server.
# The key lives in /etc/etph/.android, kept across sysupgrade.

START=19
USE_PROCD=1

start_service() {
	local keygen
	config_load etph
	config_get_bool keygen main keygen 1
	[ "$keygen" = 1 ] || return 0
	[ -s /etc/etph/.android/adbkey ] && return 0
	mkdir -p /etc/etph/.android
	chmod 700 /etc/etph /etc/etph/.android
	procd_open_instance keygen
	procd_set_param command /usr/sbin/etphonehome adb-keygen
	procd_set_param env HOME=/etc/etph
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
