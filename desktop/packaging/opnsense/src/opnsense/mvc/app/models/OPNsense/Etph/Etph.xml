<model>
    <mount>//OPNsense/etph</mount>
    <description>ETPH: an Android phone as an uplink (WAN / failover)</description>
    <version>1.0.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <transport type="OptionField">
                <Default>wifi</Default>
                <Required>Y</Required>
                <OptionValues>
                    <wifi>Wi-Fi (the phone on the network)</wifi>
                    <usb>USB (phone plugged into this firewall)</usb>
                    <auto>USB when plugged in, else Wi-Fi</auto>
                </OptionValues>
            </transport>
            <host type="HostnameField">
                <Required>N</Required>
            </host>
            <port type="PortField">
                <Default>8888</Default>
                <Required>Y</Required>
            </port>
            <token type="TextField">
                <Required>N</Required>
                <Mask>/^[A-Za-z0-9._~+\/=-]{0,128}$/</Mask>
                <ValidationMessage>The token shown in the ETPH app (letters, digits and . _ ~ + / = -).</ValidationMessage>
            </token>
        </general>
    </items>
</model>
